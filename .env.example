# =============================================================================
# Rotastic Web Multiplayer — Configuração de Ambiente (.env.example)
# Copie para .env se desejar sobrescrever os padrões locais.
# =============================================================================

# Porta HTTP e WebSocket do Servidor Autoritativo (@rotastic/server)
PORT=3001
HOST=0.0.0.0

# Taxa de simulação física determinística (60 Hz nativo do Rotastic.exe)
SIMULATION_TICK_HZ=60

# Taxa de envio de snapshots de rede aos clientes (30 Hz ou 60 Hz)
NETWORK_SNAPSHOT_HZ=30

# Porta do servidor de desenvolvimento Vite (@rotastic/client)
VITE_DEV_PORT=5173
